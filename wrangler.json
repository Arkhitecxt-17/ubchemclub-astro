{
	"name": "ubchemclub-astro",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "local-session"
		}
	],
	"d1_databases": [
		{
			"binding": "ubcc_membership",
			"database_name": "ubcc-membership",
			"database_id": "849e37df-71d1-4b43-8e57-a7c982fd88eb"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEMBERSHIP_BUCKET",
			"bucket_name": "ubcc-membership"
		}
	],
	"vars": {
		"GITHUB_CLIENT_ID": "GITHUB_CLIENT_ID",
		"SITE_URL": "https://ubchemclub-astro.202101335.workers.dev",
		"CLUB_EMAIL": "ubchemistryclub@gmail.com"
	}
}