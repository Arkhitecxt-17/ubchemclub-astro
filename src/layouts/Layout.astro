---
import BaseHead from '../components/BaseHead.astro';
import Navbar1 from '../components/starwind-pro/navbar-01/Navbar1.astro';
import Footer1 from '../components/starwind-pro/footer-01/Footer1.astro';
import "../styles/starwind.css";

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="base-body bg-background text-foreground min-h-screen flex flex-col">
    <Navbar1 />
    <main class="flex-1">
      {wide ? (
        <slot />
      ) : (
        <section class="w-full max-w-3xl mx-auto px-4 py-12">
          <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-foreground mb-2">{title}</h1>
            <hr class="border-border my-4" />
            <p class="text-muted-foreground">{description}</p>
          </div>
          <slot />
        </section>
      )}
    </main>
    <Footer1 />
  </body>
</html>