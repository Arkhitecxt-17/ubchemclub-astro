---
import Layout from "../../layouts/Layout.astro";
const submitted = Astro.url.searchParams.get("submitted");
const error = Astro.url.searchParams.get("error");
---

<Layout title="Contact Us" description="Get in touch with the University of Botswana Chemistry Club">
  <div class="max-w-2xl mx-auto w-full">

    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Get in Touch</h1>
      <p class="text-muted-foreground text-lg">Have a question or want to collaborate? We'd love to hear from you.</p>
    </div>

    {submitted === "true" ? (
      <div class="flex flex-col items-center gap-4 p-10 bg-muted rounded-2xl text-center">
        <span class="text-5xl">✅</span>
        <h2 class="text-xl font-semibold text-foreground">Message Sent!</h2>
        <p class="text-muted-foreground">Thank you! We'll get back to you as soon as possible.</p>
        <a href="/" class="mt-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:opacity-85 transition-opacity">Back to Home</a>
      </div>
    ) : (
      <div class="bg-muted rounded-2xl p-6 sm:p-8">
        {error && (
          <div class="mb-5 border border-error/40 bg-error/10 text-error-foreground rounded-xl p-4 text-sm">
            Something went wrong. Please try again.
          </div>
        )}
        <form method="POST" action="/api/contact" class="flex flex-col gap-5">
          <div class="flex flex-col gap-1.5">
            <label for="name" class="text-sm font-medium text-foreground">Full Name <span class="text-error">*</span></label>
            <input type="text" id="name" name="name" required placeholder="Your name"
              class="px-4 py-2.5 border border-border rounded-lg bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-foreground/40 transition-colors" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-medium text-foreground">Email Address <span class="text-error">*</span></label>
            <input type="email" id="email" name="email" required placeholder="you@example.com"
              class="px-4 py-2.5 border border-border rounded-lg bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-foreground/40 transition-colors" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="subject" class="text-sm font-medium text-foreground">Subject <span class="text-error">*</span></label>
            <input type="text" id="subject" name="subject" required placeholder="What is this about?"
              class="px-4 py-2.5 border border-border rounded-lg bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-foreground/40 transition-colors" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-sm font-medium text-foreground">Message <span class="text-error">*</span></label>
            <textarea id="message" name="message" rows={6} required placeholder="Your message..."
              class="px-4 py-2.5 border border-border rounded-lg bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-foreground/40 transition-colors resize-y"></textarea>
          </div>
          <button type="submit"
            class="self-start px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg text-base hover:opacity-85 transition-opacity cursor-pointer">
            Send Message
          </button>
        </form>
      </div>
    )}

  </div>
</Layout>