---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Team1 from "../components/starwind-pro/team-01/Team1.astro";

const teamEntries = await getCollection("team").catch(() => []);
console.log("Team entries:", teamEntries);
const members = teamEntries.map((e) => e.data)
---

<Layout title="About Us" description="Learn about the University of Botswana Chemistry Club" wide>
  <div class="w-full">

    <!-- Radio inputs hidden -->
    <input type="radio" name="about-tab" id="tab-history" class="hidden" checked />
    <input type="radio" name="about-tab" id="tab-team" class="hidden" />
    <input type="radio" name="about-tab" id="tab-vision" class="hidden" />

    <!-- Tab Bar -->
    <div class="tab-bar flex justify-center border-b border-border">
      <label for="tab-history" class="tab-label px-6 py-3 text-base font-medium cursor-pointer text-muted-foreground border-b-2 border-transparent -mb-px transition-colors hover:text-foreground">History</label>
      <label for="tab-team" class="tab-label px-6 py-3 text-base font-medium cursor-pointer text-muted-foreground border-b-2 border-transparent -mb-px transition-colors hover:text-foreground">Meet the Team</label>
      <label for="tab-vision" class="tab-label px-6 py-3 text-base font-medium cursor-pointer text-muted-foreground border-b-2 border-transparent -mb-px transition-colors hover:text-foreground">Vision & Mission</label>
    </div>

    <!-- Panels -->
    <div class="tab-panels">

      <section class="tab-panel panel-history">
        <div class="max-w-3xl mx-auto px-4 py-12">
          <h2 class="text-3xl font-semibold text-foreground mb-6">Our History</h2>
          <p class="text-muted-foreground leading-relaxed mb-4">
            The University of Botswana Chemistry Club (UBCC) was founded in 2024 by a group of
            passionate chemistry students who wanted to create a space for academic growth,
            collaboration, and community beyond the classroom.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            Since its founding, the club has grown to include undergraduate and postgraduate
            students, hosting seminars, lab tours, and outreach events that connect students
            with the broader scientific community in Botswana and beyond.
          </p>
        </div>
      </section>

      <section class="tab-panel panel-team">
        <Team1 members={members} />
      </section>

      <section class="tab-panel panel-vision">
        <div class="max-w-3xl mx-auto px-4 py-12 space-y-10">
          <div>
            <h2 class="text-3xl font-semibold text-foreground mb-4">Our Vision</h2>
            <p class="text-muted-foreground leading-relaxed text-lg">
              To be the leading student chemistry organisation in Botswana, fostering a culture
              of scientific curiosity, innovation, and excellence among the next generation of
              chemists.
            </p>
          </div>
          <div class="border-t border-border pt-10">
            <h2 class="text-3xl font-semibold text-foreground mb-4">Our Mission</h2>
            <ul class="space-y-3 list-disc list-inside text-muted-foreground text-lg leading-relaxed">
              <li>Promote chemistry education and awareness across the University of Botswana.</li>
              <li>Connect students with industry professionals and research opportunities.</li>
              <li>Organise workshops, seminars, and outreach events throughout the academic year.</li>
              <li>Build a supportive community for chemistry students at all levels.</li>
            </ul>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  input[name="about-tab"] { display: none; }
  .tab-panel { display: none; }

  #tab-history:checked ~ .tab-panels .panel-history,
  #tab-team:checked ~ .tab-panels .panel-team,
  #tab-vision:checked ~ .tab-panels .panel-vision {
    display: block;
  }

  #tab-history:checked ~ .tab-bar label[for="tab-history"],
  #tab-team:checked ~ .tab-bar label[for="tab-team"],
  #tab-vision:checked ~ .tab-bar label[for="tab-vision"] {
    color: hsl(var(--foreground));
    border-bottom-color: hsl(var(--foreground));
    font-weight: 600;
  }
</style>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash;
    if (hash === "#team") {
      (document.getElementById("tab-team") as HTMLInputElement).checked = true;
    } else if (hash === "#vision") {
      (document.getElementById("tab-vision") as HTMLInputElement).checked = true;
    }
  });
</script>