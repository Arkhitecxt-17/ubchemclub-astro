---
import IconBrandFacebook from "@tabler/icons/outline/brand-facebook.svg";
import IconBrandLinkedin from "@tabler/icons/outline/brand-linkedin.svg";
import IconBrandTiktok from "@tabler/icons/outline/brand-tiktok.svg";
import IconBrandWhatsapp from "@tabler/icons/outline/brand-whatsapp.svg";
import IconMail from "@tabler/icons/outline/mail.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

export interface SocialLink {
	name: string;
	href: string;
	icon: any;
}

interface Props extends HTMLAttributes<"footer"> {
	/** Array of social media links */
	socialLinks?: SocialLink[];
	/** Company name for copyright */
	companyName?: string;
}

const footer1Styles = tv({
	base: "bg-background @container w-full border-t py-12",
});

const {
	socialLinks = [
		{
			name: "Facebook",
			href: "https://facebook.com/61567213194517/",
			icon: IconBrandFacebook,
		},
		{
			name: "TikTok",
			href: "https://tiktok.com/@ubcc2024?is_from_webapp=1&sender_device=pc",
			icon: IconBrandTiktok,
		},
		{
			name: "LinkedIn",
			href: "https://www.linkedin.com/groups/13112002",
			icon: IconBrandLinkedin,
		},
		{
			name: "Whatsapp",
			href: "https://chat.whatsapp.com/F8QIGu2YFVI4SvbfSHEsXq?mode=sc%20_t",
			icon: IconBrandWhatsapp,
		},
    {
			name: "Email",
			href: "mailto:ubchemistryclub@ub.ac.bw",
			icon: IconMail,
		},
	],
	companyName = "University of Botswana Chemistry Club",
	class: className,
	...rest
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class={footer1Styles({ class: className })} {...rest}>
	<div class="mx-auto w-full max-w-7xl px-4">
		<div class="flex flex-col items-center gap-6">
			<!-- Social Links -->
			<div class="flex gap-6">
				{
					socialLinks.map((social) => (
						<a
							href={social.href}
							target={social.href.startsWith("mailto:") ? undefined : "_blank"}
							rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
							class="text-muted-foreground hover:text-foreground transition-colors"
							aria-label={social.name}
						>
							<social.icon class="size-6.5" aria-hidden="true" />
						</a>
					))
				}
			</div>

			<!-- Copyright -->
			<p class="text-muted-foreground text-center text-md">
				© {currentYear}
				{companyName}. All rights reserved.
			</p>
		</div>
	</div>
</footer>
